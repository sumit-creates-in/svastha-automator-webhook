# ---------------------------------------------------------------------------
# SVASTHA Automator — environment variables
# Copy to server/.env for local development. On Railway set these as variables.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/svastha_automator
# Railway: ${{ MongoDB.MONGO_URL }}   (reference the MongoDB service)
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/svastha_automator
MONGODB_URI=mongodb://127.0.0.1:27017/svastha_automator

# Sign-in tokens. Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Encrypts stored SMTP passwords and API keys (AES-256-GCM).
# Generate with:  openssl rand -hex 32
# WARNING: changing this makes existing saved connections unreadable.
ENCRYPTION_KEY=change-me-to-a-64-character-hex-string

# Public URL of this deployment — used to build webhook URLs shown in the UI.
APP_URL=http://localhost:8080

# Extra browser origins allowed to call the API (dev server, custom domains).
CORS_ORIGINS=http://localhost:5173

# Optional: creates the first owner account automatically on boot.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Owner

# ---- Engine tuning -------------------------------------------------------
ENGINE_ENABLED=true
ENGINE_CONCURRENCY=5
ENGINE_POLL_INTERVAL_MS=1000
ENGINE_RUN_TIMEOUT_MS=300000
ENGINE_CODE_TIMEOUT_MS=5000
ENGINE_STALLED_AFTER_MS=600000
ENGINE_INLINE_DELAY_MS=3000

# Days of run history to keep (0 = keep forever).
RUN_RETENTION_DAYS=30

LOG_LEVEL=debug
